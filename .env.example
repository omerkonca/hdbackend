PORT=5050
# En az 24 karakter; üretmek için: node scripts/generate-admin-token.js
ADMIN_TOKEN=
# 3 hatalı denemeden sonra kilitleme süresi (dakika)
ADMIN_LOCKOUT_MINUTES=30
ADMIN_MAX_FAILED_ATTEMPTS=3
MONGODB_URI=mongodb://localhost:27017/hepsiduzici

# Gezi Rehberi: OpenStreetMap + Wikipedia (ücretsiz) — ek API anahtarı gerekmez

# Medya yükleme: varsayılan Supabase Storage (city-assets).
# Cloudinary KAPALI. Açmak için USE_CLOUDINARY=true VE aşağıdaki anahtarlar gerekir.
USE_CLOUDINARY=false
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
